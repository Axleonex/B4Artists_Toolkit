+int ED_area_min_height(const ScrArea *area)
+{
+  const int header_height = ED_area_headersize();
+  if (area->spacetype != SPACE_ACTION || !area->spacedata.first) {
+    return header_height;
+  }
+  const SpaceAction *space = static_cast<const SpaceAction *>(area->spacedata.first);
+  const ARegion *tool_header = BKE_area_find_region_type(area, RGN_TYPE_TOOL_HEADER);
+  const ARegion *header = BKE_area_find_region_type(area, RGN_TYPE_HEADER);
+  if (space->mode != SACTCONT_TIMELINE || !tool_header || !header ||
+      (header->flag & RGN_FLAG_HIDDEN) ||
+      (tool_header->flag & (RGN_FLAG_HIDDEN | RGN_FLAG_HIDDEN_BY_USER)) ||
+      !tool_header->runtime->type ||
+      BLI_listbase_is_empty(&tool_header->runtime->type->headertypes))
+  {
+    return header_height;
+  }
+  int min_height = int(ceil(48.0f * UI_SCALE_FAC));
+  for (const ARegion &region : area->regionbase) {
+    if (ELEM(region.regiontype, RGN_TYPE_HEADER, RGN_TYPE_TOOL_HEADER) &&
+        !(region.flag & RGN_FLAG_HIDDEN))
+    {
+      min_height += header_height;
+    }
+  }
+  return min_height;
+}
+
+static int area_geometry_min_height(const ScrArea *area, const rcti *screen_rect)
+{
+  const int border_width = int(ceil(float(U.border_width) * UI_SCALE_FAC));
+  const int min_height = ED_area_min_height(area);
+  if (area->v3->vec.y >= screen_rect->ymax - 1) {
+    return min_height + border_width;
+  }
+  if (area->v4->vec.y <= screen_rect->ymin + 1) {
+    return min_height + border_width + 1;
+  }
+  return min_height + 2 * border_width - U.pixelsize;
+}
+
+/** Move only as much of the requested growth as all connected neighbors can afford. */
+static int timeline_toolbar_grow_edge(const wmWindow *win,
+                                     bScreen *screen,
+                                     ScrEdge *edge,
+                                     const rcti *screen_rect,
+                                     const int requested,
+                                     const bool upwards)
+{
+  if (!edge || edge->v1->vec.y <= screen_rect->ymin ||
+      edge->v1->vec.y >= screen_rect->ymax - 1)
+  {
+    return 0;
+  }
+  struct VertexFlag {
+    ScrVert *vertex;
+    short flag;
+  };
+  Vector<VertexFlag> saved_flags;
+  ED_screen_verts_iter(win, screen, vertex)
+  {
+    saved_flags.append({vertex, vertex->flag});
+  }
+  screen_geom_select_connected_edge(win, edge);
+  int available = upwards ? screen_rect->ymax - 1 - edge->v1->vec.y :
+                            edge->v1->vec.y - screen_rect->ymin;
+  for (const ScrArea &neighbor : screen->areabase) {
+    const bool bottom_selected = neighbor.v1->flag && neighbor.v4->flag;
+    const bool top_selected = neighbor.v2->flag && neighbor.v3->flag;
+    if (bottom_selected && top_selected) {
+      /* A degenerate area cannot safely lend space. */
+      available = 0;
+      break;
+    }
+    if (upwards ? bottom_selected : top_selected) {
+      available = std::min(available,
+                           screen_geom_area_height(&neighbor) -
+                               area_geometry_min_height(&neighbor, screen_rect));
+    }
+  }
+  const int moved = std::max(0, std::min(requested, available));
+  if (moved != 0) {
+    const int offset = upwards ? moved : -moved;
+    for (ScrVert &vertex : screen->vertbase) {
+      if (vertex.flag) {
+        vertex.vec.y += offset;
+      }
+    }
+  }
+  for (const VertexFlag &saved : saved_flags) {
+    saved.vertex->flag = saved.flag;
+  }
+  return moved;
+}
+
+bool ED_area_timeline_toolbar_ensure(const wmWindow *win, bScreen *screen, ScrArea *area)
+{
+  if (!win || !screen || !area || WM_window_get_active_screen(win) != screen ||
+      BLI_findindex(&screen->areabase, area) == -1)
+  {
+    return false;
+  }
+  if (ED_area_min_height(area) == ED_area_headersize()) {
+    timeline_toolbar_warning_update(screen, area, false);
+    return true;
+  }
+  rcti screen_rect;
+  WM_window_screen_rect_calc(win, &screen_rect);
+  int needed = area_geometry_min_height(area, &screen_rect) - screen_geom_area_height(area);
+  if (needed <= 0) {
+    timeline_toolbar_warning_update(screen, area, false);
+    return true;
+  }
+  struct VertexPosition {
+    ScrVert *vertex;
+    short y;
+  };
+  Vector<VertexPosition> positions;
+  for (ScrVert &vertex : screen->vertbase) {
+    positions.append({&vertex, vertex.vec.y});
+  }
+  needed -= timeline_toolbar_grow_edge(win,
+                                      screen,
+                                      BKE_screen_find_edge(screen, area->v2, area->v3),
+                                      &screen_rect,
+                                      needed,
+                                      true);
+  if (needed > 0) {
+    needed -= timeline_toolbar_grow_edge(win,
+                                        screen,
+                                        BKE_screen_find_edge(screen, area->v1, area->v4),
+                                        &screen_rect,
+                                        needed,
+                                        false);
+  }
+  if (needed > 0) {
+    /* Physically impossible: leave the requested visibility stable and roll back geometry. */
+    for (const VertexPosition &saved : positions) {
+      saved.vertex->vec.y = saved.y;
+    }
+    timeline_toolbar_warning_update(screen, area, true);
+    return false;
+  }
+  timeline_toolbar_warning_update(screen, area, false);
+  screen->do_refresh = true;
+  for (ScrArea &changed : screen->areabase) {
+    ED_area_tag_redraw_no_rebuild(&changed);
+  }
+  return true;
+}
