+static bool timeline_toolbar_poll(bContext *C)
+{
+  if (!ED_operator_areaactive(C)) {
+    return false;
+  }
+  const ScrArea *area = CTX_wm_area(C);
+  if (area->spacetype != SPACE_ACTION || !area->spacedata.first ||
+      static_cast<const SpaceAction *>(area->spacedata.first)->mode != SACTCONT_TIMELINE)
+  {
+    CTX_wm_operator_poll_msg_set(C, "A Timeline editor is required");
+    return false;
+  }
+  return true;
+}
+
+static wmOperatorStatus timeline_toolbar_set_exec(bContext *C, wmOperator *op)
+{
+  ScrArea *area = CTX_wm_area(C);
+  ARegion *tool_header = BKE_area_find_region_type(area, RGN_TYPE_TOOL_HEADER);
+  if (!tool_header) {
+    BKE_report(op->reports, RPT_ERROR, "Timeline toolbar region has not initialized");
+    return OPERATOR_CANCELLED;
+  }
+  const bool enabled = RNA_boolean_get(op->ptr, "enabled");
+  const bool user_action = RNA_boolean_get(op->ptr, "user_action");
+  if (enabled && !user_action && (tool_header->flag & RGN_FLAG_HIDDEN_BY_USER)) {
+    BKE_report(op->reports, RPT_INFO, "Timeline toolbar is hidden by the user");
+    return OPERATOR_CANCELLED;
+  }
+  if (user_action) {
+    SET_FLAG_FROM_TEST(tool_header->flag, !enabled, RGN_FLAG_HIDDEN_BY_USER);
+  }
+  SET_FLAG_FROM_TEST(tool_header->flag, !enabled, RGN_FLAG_HIDDEN);
+  ED_area_timeline_toolbar_ensure(CTX_wm_window(C), CTX_wm_screen(C), area);
+  ED_region_visibility_change_update(C, area, tool_header);
+  ED_area_tag_redraw(area);
+  WM_event_add_notifier(C, NC_SCREEN | NA_EDITED, nullptr);
+  return OPERATOR_FINISHED;
+}
+
+static void SCREEN_OT_timeline_toolbar_set(wmOperatorType *ot)
+{
+  ot->name = "Show Timeline Toolbar";
+  ot->idname = "SCREEN_OT_timeline_toolbar_set";
+  ot->description = "Show or hide the native Timeline toolbar while preserving its ruler and keys";
+  ot->poll = timeline_toolbar_poll;
+  ot->exec = timeline_toolbar_set_exec;
+  ot->flag = 0;
+  RNA_def_boolean(ot->srna, "enabled", true, "Enabled", "Display the native Timeline toolbar");
+  RNA_def_boolean(ot->srna,
+                  "user_action",
+                  false,
+                  "User Action",
+                  "Record an explicit visibility choice instead of an add-on lifecycle change");
+}
