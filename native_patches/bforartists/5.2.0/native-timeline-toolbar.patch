+/* Runtime-only warning state; a resize failure must not emit a report on every refresh. */
+static Map<const ScrArea *, const bScreen *> timeline_toolbar_warned_areas;
+
+static void timeline_toolbar_warning_update(const bScreen *screen,
+                                            const ScrArea *area,
+                                            const bool failed)
+{
+  if (!failed) {
+    timeline_toolbar_warned_areas.remove(area);
+    return;
+  }
+  if (timeline_toolbar_warned_areas.lookup_default(area, nullptr) == screen) {
+    return;
+  }
+  timeline_toolbar_warned_areas.add_overwrite(area, screen);
+  /* Resize, DPI and file-load geometry has no operator/context report list. Use a global UI
+   * banner only once per constraint failure; hide or successful sizing resets this guard. */
+  WM_global_report(RPT_WARNING,
+                   "Not enough window space for the Timeline toolbar and keys; enlarge the window "
+                   "or simplify its layout");
+}
